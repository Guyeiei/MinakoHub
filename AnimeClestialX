-- Function to get targets
local function getAvailableHatchTargets()
    local hatchTargets = {}
    if EggParent then
        for _, egg in ipairs(EggParent:GetChildren()) do
            table.insert(hatchTargets, egg.Name)
        end
    end
    table.sort(hatchTargets, function(a, b)
        local numA = tonumber(a:match("%d+")) or 0
        local numB = tonumber(b:match("%d+")) or 0
        return numA < numB
    end)
    return #hatchTargets > 0 and hatchTargets or {"No Eggs Found"}
end

local function TeleportToEgg(eggName)
    local eggFolder = EggParent:FindFirstChild(eggName)
    if eggFolder and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        Player.Character.HumanoidRootPart.CFrame = eggFolder:GetModelCFrame() * CFrame.new(0, 3, 5)
    end
end

