function getAvailableMaps()
    local mapNames = {}
    table.insert(mapNames, "Map3")
    return mapNames
end

local function getAvailableHatchTargets()
    local hatchTargets = {}
    if EggParent then
        for _, egg in ipairs(EggParent:GetChildren()) do
            table.insert(hatchTargets, egg.Name)
        end
    end
    table.sort(hatchTargets, function(a, b)
        local numA = tonumber(a:match("ergg_scene(%d+)")) or 0
        local numB = tonumber(b:match("ergg_scene(%d+)")) or 0
        return numA < numB
    end)
    if #hatchTargets == 0 then
        return {"DefaultHatch"}
    end
    return hatchTargets
end

local function getHatchAmount(option)
    local amounts = {
        ["Single"] = 1,
        ["Three"] = 3,
        ["Five"] = 5,
        ["Ten"] = 10,
        ["Twenty"] = 20,
        ["Fifty"] = 50
    }
    return amounts[option] or 1
end

