function StartFastClick()
    if fastClicking then return end
    fastClicking = true
    task.spawn(function()
        while fastClicking do
            if PlayerAttackRemote then
                pcall(function()
                    PlayerAttackRemote:FireServer()
                end)
            end
            if ClickEventRemote then
                local args = {0, 1}
                pcall(function()
                    ClickEventRemote:FireServer(unpack(args))
                end)
            end
            task.wait(clickDelay)
        end
    end)
end

function StopFastClick()
    fastClicking = false
end

